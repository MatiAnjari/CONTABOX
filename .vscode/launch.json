{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ContaBox (Flask)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "run.py",
        "FLASK_DEBUG": "1"
      },
      "args": [
        "run",
        "--no-debugger",
        "--no-reload"
      ],
      "jinja": true
    },
    {
      "name": "Crear base de datos",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/init_db.py"
    },
    {
      "name": "Cargar datos de demostración",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/seed_demo.py"
    }
  ]
}